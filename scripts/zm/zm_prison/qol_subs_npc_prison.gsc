// ----- maps\mp\zm_prison_sq_final::stage_one  (stock verbatim + 1 caption line(s)) -----
zmqol_npc_stage_one()
{
    println( "[zm_qol] subtitles: hook ran - stage_one" );

    if ( isdefined( level.gamedifficulty ) && level.gamedifficulty == 0 )
    {
        maps\mp\zm_prison_sq_final::sq_final_easy_cleanup();
        return;
    }

    precachemodel( "p6_zm_al_audio_headset_icon" );
    flag_wait( "quest_completed_thrice" );
    flag_wait( "spoon_obtained" );
    flag_wait( "warden_blundergat_obtained" );

    for ( i = 1; i < 4; i++ )
    {
        m_nixie_tube = getent( "nixie_tube_" + i, "targetname" );
        m_nixie_tube thread maps\mp\zm_prison_sq_final::nixie_tube_scramble_protected_effects( i );
    }

    level waittill_multiple( "nixie_tube_trigger_1", "nixie_tube_trigger_2", "nixie_tube_trigger_3" );
    level thread maps\mp\zm_prison_sq_final::nixie_final_codes( 386 );
    level thread maps\mp\zm_prison_sq_final::nixie_final_codes( 481 );
    level thread maps\mp\zm_prison_sq_final::nixie_final_codes( 101 );
    level thread maps\mp\zm_prison_sq_final::nixie_final_codes( 872 );
    level waittill_multiple( "nixie_final_" + 386, "nixie_final_" + 481, "nixie_final_" + 101, "nixie_final_" + 872 );
    maps\mp\zm_prison_sq_final::nixie_tube_off();
    m_nixie_tube = getent( "nixie_tube_1", "targetname" );
    scripts\zm\zmqol_subtitles::zmqol_subs_npc( "vox_brutus_nixie_right_0", m_nixie_tube, undefined, undefined );
    m_nixie_tube playsoundwithnotify( "vox_brutus_nixie_right_0", "scary_voice" );
    m_nixie_tube waittill( "scary_voice" );
    wait 3;
    level thread maps\mp\zm_prison_sq_final::stage_two();
}

