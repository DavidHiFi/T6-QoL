{
    println( "[zm_qol] subtitles: hook ran - nixie_935_audio" );

    if ( !( isdefined( level.music_override ) && level.music_override ) )
    {
        level.music_override = 1;
        playsoundatposition( "mus_zmb_secret_song_2", ( 0, 0, 0 ) );
        wait 140;
        level.music_override = 0;
