// ----- maps\mp\zm_tomb_ee_main_step_5::quadrotor_pickup_think  (stock verbatim + 1 caption line(s)) -----
zmqol_npc_quadrotor_pickup_think()
{
    println( "[zm_qol] subtitles: hook ran - quadrotor_pickup_think" );

    self endon( "kill_trigger" );
    m_quadrotor = getent( "quadrotor_pickup", "targetname" );

    while ( true )
    {
        self waittill( "trigger", player );
        scripts\zm\zmqol_subtitles::zmqol_subs_npc( "vox_maxi_drone_upgraded_0", player, undefined, undefined );
        player playsound( "vox_maxi_drone_upgraded_0" );
        flag_clear( "ee_quadrotor_disabled" );
        flag_set( "ee_maxis_drone_retrieved" );
        m_quadrotor delete();
    }
}
