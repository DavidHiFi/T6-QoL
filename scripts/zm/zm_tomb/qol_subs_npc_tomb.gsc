    wait 0.5;
    scripts\zm\zmqol_subtitles::zmqol_subs_npc( "vox_maxi_robot_await_0", self, undefined, undefined );
    self playsoundwithnotify( "vox_maxi_robot_await_0", "ready_to_use" );
    self waittill( "ready_to_use" );
    maps\mp\zombies\_zm_unitrigger::register_static_unitrigger( unitrigger_stub, ::zmqol_npc_activate_fire_link );
}

// ----- maps\mp\zm_tomb_ee_main_step_3::activate_fire_link  (stock verbatim + 1 caption line(s)) -----
zmqol_npc_activate_fire_link()
{
    println( "[zm_qol] subtitles: hook ran - activate_fire_link" );

    self endon( "kill_trigger" );

    while ( true )
    {
        self waittill( "trigger", player );
        self playsound( "zmb_squest_robot_button" );

        if ( flag( "three_robot_round" ) )
        {
            level thread zmqol_npc_fire_link_cooldown( self );
            self playsound( "zmb_squest_robot_button_activate" );
            self playloopsound( "zmb_squest_robot_button_timer", 0.5 );
            flag_waitopen( "fire_link_enabled" );
            self stoploopsound( 0.5 );
            self playsound( "zmb_squest_robot_button_deactivate" );
        }
        else
        {
            scripts\zm\zmqol_subtitles::zmqol_subs_npc( "vox_maxi_robot_abort_0", self, undefined, undefined );
            self playsound( "vox_maxi_robot_abort_0" );
            self playsound( "zmb_squest_robot_button_deactivate" );
            wait 3;
        }
    }
}

