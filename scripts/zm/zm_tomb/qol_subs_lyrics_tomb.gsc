            a[a.size] = "391|443|I'll bring them down on my own, yeah";
            a[a.size] = "612|679|First to go, first to go, last to know";
            a[a.size] = "680|694|Always the only one I control";
            a[a.size] = "698|774|Lashing out, giving in, then letting go to begin again";
