            a[a.size] = "1090|1109|And you know it's right.";
            a[a.size] = "1110|1168|I am your war, arming the strong, aiding the weak";
            a[a.size] = "1186|1219|Know me by name, Shepherd of Fire";
            a[a.size] = "1252|1278|Well, I can promise you paradise.";
            a[a.size] = "1285|1314|No need to serve on your knees.";
            a[a.size] = "1324|1363|And when you're lost in the darkest of hours";
            a[a.size] = "1366|1405|Take a moment and tell me who you see.";
            a[a.size] = "1409|1443|Won't tell you who not to be";
            a[a.size] = "1451|1463|Now you know.";
            a[a.size] = "1464|1482|I am your pride";
            a[a.size] = "1483|1519|Agent of wealth, bearer of needs.";
            a[a.size] = "1524|1540|And you know it's right.";
            a[a.size] = "1541|1600|I am your war, arming the strong, aiding the weak";
            a[a.size] = "1616|1647|Know me by name, Shepherd of Fire";
            a[a.size] = "2194|2228|Disciple of the Cross and champion in suffering";
            a[a.size] = "2229|2266|Immerse yourself into the Kingdom of Redemption.";
            a[a.size] = "2270|2301|Pardon your mind from the chains of the divine";
            a[a.size] = "2302|2328|Make way, the Shepherd of Fire";
            a[a.size] = "2338|2402|Through the ages of time, I've been known for my hate.";
            a[a.size] = "2410|2448|But I'm a dealer of simple choices.";
            a[a.size] = "2448|2472|For me, it's never too late.";
            a[a.size] = "2472|2532|I am your pride, agent of wealth, bearer of needs";
            a[a.size] = "2534|2552|And you know it's right.";
