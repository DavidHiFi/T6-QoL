            a[a.size] = "1923|1962|I bring the end just like an archangel";
            a[a.size] = "1963|2002|Why do we end up here?";
            a[a.size] = "2004|2032|Live in fire and feel so cold";
            a[a.size] = "2033|2113|We burn together forever, waiting for the one";
            a[a.size] = "2532|2550|Letting go";
            a[a.size] = "2569|2597|Letting go now.";
            a[a.size] = "2615|2673|Letting go, our time is up, dust from our bones";
            a[a.size] = "2674|2696|This time we don't wake up.";
            a[a.size] = "2698|2762|Finding out where you've been, wait in silence";
