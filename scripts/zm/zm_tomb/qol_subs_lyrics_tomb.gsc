            a[a.size] = "943|1024|Burning down, caving in, die by fire and";
            a[a.size] = "1026|1067|Begin again; what breaks my pride will break your skull";
            a[a.size] = "1067|1110|I bring the end just like an archangel";
            a[a.size] = "1227|1269|The wheel won't be turning for long now.";
            a[a.size] = "1325|1348|Coming home";
            a[a.size] = "1364|1392|Letting go, letting go now";
