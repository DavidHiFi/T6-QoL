            a[a.size] = "328|371|I was spawned from eternal night by infernal rite";
            a[a.size] = "371|398|And I need your carrion.";
            a[a.size] = "400|425|Neurons fire when I violate";
            a[a.size] = "425|442|Pupils dilate";
            a[a.size] = "442|471|And I feel your carrion.";
            a[a.size] = "474|515|I could scream but I know I won't hear myself.";
            a[a.size] = "515|544|I'm a slave to synapses";
            a[a.size] = "544|585|In my dream is the sound of a lullaby.";
            a[a.size] = "586|631|Calling me the one.";
            a[a.size] = "645|671|I'm undone.";
            a[a.size] = "681|751|And the law runs from the chosen one.";
            a[a.size] = "751|808|Vermin martyr, just as planned";
            a[a.size] = "808|842|Asking why must I be damned";
            a[a.size] = "842|884|I was spawned from eternal night by infernal rite";
            a[a.size] = "884|911|And I need your carrion.";
            a[a.size] = "913|937|Neurons fire when I violate";
            a[a.size] = "938|954|Pupils dilate";
            a[a.size] = "955|982|And I feel your carrion.";
            a[a.size] = "983|1009|I bring doom and defile light";
            a[a.size] = "1010|1055|Your entire life will now cease to carry on.";
            a[a.size] = "1056|1082|I've returned and I'm not alone.";
            a[a.size] = "1082|1100|Never to atone.";
            a[a.size] = "1100|1114|And forever carry";
            a[a.size] = "1121|1187|On and on until everyone is gone";
            a[a.size] = "1190|1206|Hear them begging.";
            a[a.size] = "1207|1225|And they're pleading.";
            a[a.size] = "1226|1243|And they're crying.";
            a[a.size] = "1244|1259|See them bleeding.";
            a[a.size] = "1260|1295|And they run and run.";
            a[a.size] = "1297|1329|Till they cannot carry on.";
            a[a.size] = "1329|1367|Carry on. Carry on.";
