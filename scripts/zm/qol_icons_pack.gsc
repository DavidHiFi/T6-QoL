// Black Ops 4 Icons for players 5-8: Reznov, Mason, Woods and Menendez.
// qol_characters owns the appearance and portrait slot; zone_source/mod_qol_icons.zone links the models.
init()
{
    scripts\zm\qol_characters::register( 4, "Reznov", "c_halo_t6_reznov_fb", "c_halo_t6_reznov_viewhands" );
    scripts\zm\qol_characters::register( 5, "Mason", "c_halo_t6_mason_fb", "c_halo_t6_mason_viewhands" );
    scripts\zm\qol_characters::register( 6, "Woods", "c_halo_t6_woods_fb", "c_halo_t6_woods_viewhands" );
    scripts\zm\qol_characters::register( 7, "Menendez", "c_halo_t6_menendez_fb", "c_halo_t6_menendez_viewhands" );
}
