<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <Nullable>enable</Nullable>
    <AssemblyName>QualityOfLifeSeries</AssemblyName>
    <RootNamespace>QolSeriesInstaller</RootNamespace>
    <ApplicationIcon>..\installer\Mod Files\qol_installer.ico</ApplicationIcon>
    <Version>1.0.4</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    The support files (icon, launch scripts, ReShade presets and DLL - about 4 MB) are zipped into
    the exe, so one downloaded file is a complete program. Payload.Unpack writes them back out.
  -->
  <Target Name="PackPayload" BeforeTargets="PrepareForBuild">
    <!-- obj\ does not exist yet on a clean clone, and ZipDirectory will not create it. -->
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)\..\installer\Mod Files"
                  DestinationFile="$(IntermediateOutputPath)ModFiles.zip"
                  Overwrite="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)ModFiles.zip" LogicalName="ModFiles.zip" />
    </ItemGroup>
  </Target>
</Project>
