// Call Of Duty: Black Ops II
>game,T6

// magmagat_donor - the MagmaGat and Magmus Operandi as T6 assets, carved out of
// luckass's T6 MotD MagmaGat mod v1.0.5 (https://github.com/lborruto/t6_motd_magmagat,
// release mod.ff, used with credit). Only the weapon's own art is listed: the two
// BO4 gun model pairs, the blob model, the three BO4-foley view anims and the eight
// mg/ effects the defs and the weapon script name. Everything else in his 616-asset
// fastfile stays out, so this donor can only ever add names, never re-own one.
// See how_this_was_built.zone.txt beside this file.
//
// v2.15.43 - THE QUEST IS BACK (owner, 2026-10-07: obtain the Magmagat the way the
// original mod intended - his Mob of the Dead quest, not the mystery box). The
// additions below carry his quest art and the Tempered Blundergat pair, as assets
// copied straight out of the same --load of his release fastfile every item above
// uses. His own zm_prison_magmagat.gsc/.csc ship beside them.

// the gun: BO4 view/world pairs; the far world LODs and the lava-tank material ride
// along as the xmodel's own dependencies
xmodel,mg_magmagat_view
xmodel,mg_magmagat_world
xmodel,mg_magmus_view
xmodel,mg_magmus_world
// the lava blob projectile model (the blob def's projectileModel)
xmodel,mg_magma_blob

// the three copied Blundergat anims that carry BO4's reload/cock foley notetracks
xanim,mg_viewmodel_magmagat_first_raise
xanim,mg_viewmodel_magmagat_reload
xanim,mg_viewmodel_magmagat_reload_empty

// both defs' muzzle flashes (Harry's fire-coloured copies of the Acid Gat's, under
// his mg/ namespace) and the effects the weapon script loadfx's by name
fx,mg/fx_blundersplat_muzzleflash
fx,mg/fx_blundersplat_muzzleflash_3p
fx,mg/fx_blundersplat_muzzleflash_ug
fx,mg/fx_blundersplat_muzzleflash_ug_3p
fx,mg/fx_magmagat_trail_bolt
fx,mg/fx_magmagat_impact
fx,mg/fx_magmagat_explode
fx,mg/fx_prison_magmagat_aoe

// ---- the quest (v2.15.43): every custom prop his smelter/hearth/forge uses ----
// His Tempered Blundergat xmodel pair (the pair's model set, including their blue
// barrel skins and their own materials/images in the dependency closure). The
// two Tempered WEAPON DEFS ride as raw files in weapons\zm\ - both are over the
// 20480 rawfile ceiling in his release, but the mod's proven build_defs trims
// (the zero bounce/attachWorldModelOffset field families his build zeroed) put
// them under it while every surviving field byte-matches his dump; see
// magmagat-quest-001\build_tempered_defs.py.
xmodel,mg_tempered_view
xmodel,mg_tempered_world
xmodel,mg_tempered_up_view
xmodel,mg_tempered_up_world
// the forge: the smelter press body/ram/lever, the five blue drums and their fill
// glows, the soul skulls and the two stocky ghouls that man the lever. Those two
// use his fxanim_props animtree carry: his atr is a superset of the stock one
// (the 4 stock-only lines are comment drift only), so first-load-wins stays safe.
xmodel,mg_press_body
xmodel,mg_press_ram
xmodel,mg_press_lever
xmodel,mg_barrel_green
xmodel,mg_barrel_fill
xmodel,mg_skull_bo4
xmodel,mg_skull_bo4_lit
xmodel,mg_ghoul1
xmodel,mg_ghoul2
xanim,mg_ghoul_smelter_1
xanim,mg_ghoul_smelter_2
rawfile,animtrees/fxanim_props.atr

// the quest's own flame/forge flames (his mg/ namespace; the stock Alcatraz fx his
// script also loads resolve from zm_prison's zones at runtime)
fx,mg/fx_alcatraz_blue_flame_flare_up
fx,mg/fx_alcatraz_blue_flame_loop
fx,mg/fx_alcatraz_blue_flame_skull
fx,mg/fx_alcatraz_blue_flame_vm
fx,mg/fx_alcatraz_lockdown_wardens
fx,mg/fx_alcatraz_magmagat_power
fx,mg/fx_mg_barrel_flame
fx,mg/fx_mg_barrel_flare
fx,mg/fx_mg_forge_fire
fx,mg/fx_mg_forge_flare
fx,mg/fx_prison_magmagat_press_fire
